  "cards": [
    {
      "dot": "cyan",
      "title": "三类注册入口",
      "items": [
        "宿主 App 用 GWIoT.initialize(opts) 与 registerHostService 注入 IHostService 实现",
        "插件层用 GWPlugin.register(component) 写入 ComponentManager",
        "27 个内置 GWIot*Component 为 object 单例，由 GWIoT / GWPlugin 直接接口委托，无需注册"
      ]
    },
    {
      "dot": "violet",
      "title": "契约分层",
      "items": [
        "cross_platform/ 是跨平台层公开的组件契约，共 20 个接口",
        "sub/ 是插件与宿主实现的注册槽，共 32 个接口",
        "仅 IPluginComponent、IPropComponent、IPushMsgHandlerComponent 继承 ISolutionSeparate",
        "IPropsComponent 是唯一继承 sub 契约的 cross_platform 接口（组合 IPropComponent）"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与平台层",
      "items": [
        "DataRepository 是唯一读写 Room 表的入口，并向上层发布 LiveData",
        "Device、User、ProductInfo、PlatformConfig、UserConfigData 同时是 DTO 与 Room 表",
        "Platform 以 expect/actual 提供建库、语言与版本号等平台差异",
        "业务模块 UserMessageManager 订阅页面生命周期并复用组件查询用户消息",
        "内置组件直接以 LiveData / LiveEvent 暴露状态（如 isLogin、deviceList）"
      ]
    }
  ]
}
